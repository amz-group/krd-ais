{
  "name": "RecognitionRecord",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "title": "Recognized word"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence"
    },
    "source": {
      "type": "string",
      "enum": [
        "camera",
        "upload"
      ],
      "default": "camera"
    }
  },
  "required": [
    "word",
    "confidence",
    "source"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}